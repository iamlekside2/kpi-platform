# Production environment for the KPI Platform backend on the IIS server.
# setup-server.ps1 copies this to backend\.env (if missing) and auto-generates
# the JWT secrets. You MUST fill in the real Postgres password.

NODE_ENV=production
# PORT is injected by IIS (HttpPlatformHandler) — do not set it here.

# Database — Postgres already running on this VPS
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/kpi_platform

# Auth — setup-server.ps1 replaces GENERATE_ME with random values
JWT_SECRET=GENERATE_ME
JWT_REFRESH_SECRET=GENERATE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS / links in emails
FRONTEND_URL=https://kpi.calmglobal.com

# Email (optional — password reset & notifications; leave empty to disable)
RESEND_API_KEY=
RESEND_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
