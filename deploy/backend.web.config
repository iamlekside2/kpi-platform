<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the KPI Platform backend, mounted as the /api sub-application
  of the kpi.calmglobal.com site. Uses HttpPlatformHandler to launch Node and
  proxy requests to it (the original /api/... path is forwarded unchanged,
  which matches the Express routes mounted at /api).
  Copy this file to the backend folder as web.config (setup-server.ps1 does this).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments=".\src\index.js"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- allow larger uploads (matches express 5mb json limit) -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
