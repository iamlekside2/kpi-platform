# App
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kpi_platform

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email — appraisal notifications need one of these three configured.
# Priority: Brevo → Resend → SMTP. With none set, mail is skipped and only
# logged, so appraisal emails silently never arrive.
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Used to build links in notification emails — must be the public site URL
FRONTEND_URL=
